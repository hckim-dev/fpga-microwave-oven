# 로컬 검증 결과와 재생성 프로젝트
/build/

# Vivado 생성 디렉터리: XPR과 관리하는 .srcs 소스는 유지
/*.cache/
/*.gen/
/*.hw/
/*.ip_user_files/
/*.runs/
/*.sim/
/*.tmp/
/*.srcs/utils_1/
/.Xil/
/xsim.dir/

# 저장소 루트에서 실행한 Vivado/XSim의 산출물
# docs/에 선별한 검증 근거는 확장자로 일괄 제외하지 않음
/*.jou
/*.log
/*.pb
/*.str
/*.wdb
/*.vcd
/*.dcp
/*.bit
/*.ltx
/*.rpt
/vivado*.backup.*
/webtalk*.xml
/usage_statistics_webtalk.*
/hs_err_pid*
/replay_pid*
/clockInfo.txt
/*.xpr.bak

# Python 환경과 캐시
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 개인 편집기 설정, 백업과 운영체제 메타데이터
/.vscode/
/.idea/
*~
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
